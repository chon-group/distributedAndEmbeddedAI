{"id":6,"name":"giacamoLife","agents":[{"archClass":"Jason","name":"giacamo","sourceCode":"/* Crenças iniciais */\nstock(10).       // This is a Belief that represents the pizza stock.\nenergy(2).      // ... the Giacomo life energy.\nhappiness(6).\t// ... the Giacomo life happiness.\npayment(+2).    // ... how many pizzas does Giacomo get by a working day?\nworkingDay(-1). // ... how much energy does Giacomo lose in a working day?\npartyNight(-1). // ... how much energy does Giacomo lose on a party night?\n\n/* Objetivo Inicial */\n!goToParty.\n\n/* Planos */\n+!goToParty: energy(E) & workingDay(W) & partyNight(N) & (E+(N+W)>1) <-\n\t!info(\"Indo pra festa!!!\"); \n\t-+energy(E+N); \n\t-+happiness(10); \n\t!goToParty.\n\n+!goToParty: energy(E) & workingDay(W) & partyNight(N) & (E+(N+W)<=1)<- \n\t!info(\"Estou cansado..........\"); \n\t!eat.\n\n+!eat: stock(S) &  energy(E) & workingDay(W) & partyNight(N) & (E<2*(-1*(N+W))) & S>0  <-\n\t!info(\"Estou trabalhando.........\"); \n\t-+stock(S-1); \n\t-+energy(E+1); \n\t!eat.\n\n+!eat: energy(E) & workingDay(W) & partyNight(N) & (E>=2*(-1*(N+W))) <-\n\t!info(\"Estou cheio...........\"); \n\t!goToParty.\n\n+!eat: stock(S) &  energy(E) & payment(P) & workingDay(W) & partyNight(N) & happiness(H) & S=0  <- \n\t!work.\n\n+!work: stock(S) &  energy(E) & payment(P) & workingDay(W) & partyNight(N) & happiness(H) <-\n\t!info(\"Estou trabalhando........\"); \n\t-+stock(S+P); -+energy(E+W); -+happiness(H-1); !eat.\n\n+!info(Msg): stock(S) &  energy(E) & happiness(H)<- \n\t.random(R);\n\t.wait(2000*R); \n\t.print(Msg,\" [energy=\",E,\"] [stock=\",S,\"] [happiness=\",H,\"]\").\n\n\n/* Belief Plans */\n+energy(E): E<1 <- \n\t!info(\"Sem Energia.....\"); \n\t.print(\"Giacomo is dead!\"); \n\t.stopMAS.\n\n+happiness(H): H<1 <- \n\t!info(\"Sem alegria..\"); \n\t.print(\"Died of sadness!\"); \n\t.stopMAS."}],"firmwares":[]}