{"id":9,"name":"parteTres","agents":[{"archClass":"Communicator","name":"oraculo","sourceCode":"curso(\"Introdução a Agentes Cognitivos\").\nevento(\"SEPEX 2026\").\n\n!conectar.\n\n+!conectar <-\n\t.connectCN(skynet.chon.group,5000,\"9fdc0520-22ee-4701-a37b-852f25a3164c\").\n\n+!start <- \n    !fazerSaudacao; \n    !dizerNome;\n    !escolherNrdaSorte;\n    !fazerNumerologia.\n\n+!fazerNumerologia <- \n    ?numeroDaSorte(N); \n    !analisarParidade(N); \n    .print(\"Procurando meu primo da sorte...\");\n    !proximoPrimo(N).\n\n+!proximoPrimo(N): not achouPrimo <- \n    Proximo = N+1; \n    !!testarPrimo(Proximo); \n    .wait(100); \n    !proximoPrimo(Proximo).\n\n+!proximoPrimo(N): achouPrimo <- \n    ?proximoPrimodaSorte(P); \n    .print(\"O próximo primo do meu numero da sorte é: \",P).\n\n+!testarPrimo(P): not achouPrimo & P >= 2 <-\n    !procurandoPrimo(P,2).\n\n+!procurandoPrimo(PossivelPrimo,Divisor): \n    Divisor*Divisor > PossivelPrimo <- \n    +achouPrimo; \n    +proximoPrimodaSorte(PossivelPrimo).\n\n+!procurandoPrimo(PossivelPrimo,Divisor): \n    PossivelPrimo mod Divisor == 0 <- \n    Dividendo = PossivelPrimo/Divisor;\n    .print(PossivelPrimo,\" nao e primo, pois (\",Dividendo,\"*\",Divisor,\"=\",PossivelPrimo,\")\").\n\n+!procurandoPrimo(PossivelPrimo,Divisor): \n Divisor*Divisor <= PossivelPrimo & PossivelPrimo mod Divisor \\== 0 <-\n    NovoDivisor = Divisor + 1;\n    !procurandoPrimo(PossivelPrimo,NovoDivisor).\n\n\n// Paridade\n+!analisarParidade(N): N mod 2 == 0 <- \n    .print(\"Meu numero é par!\").\n+!analisarParidade(N): N mod 2 == 1 <- \n    .print(\"Meu numero é impar!\").\n\n//Planos de Crença...\n+numeroDaSorte(N)[source(Agt)]: N mod 2 == 0 <- \n    .print(\"Segundo a numerologia, esse número indica que hoje \",Agt,\" está equilibrado, paciente e reflexivo\").\n+numeroDaSorte(N)[source(Agt)]: N mod 2 == 1 <- \n    .print(\"Segundo a numerologia, esse número indica que hoje \",Agt,\" está mais independente, criativo e aventureiro\").\n\n// Numero da sorte\n+!escolherNrdaSorte <- \n    .random(R); \n    N = ((R * 1000) div 1); \n    .print(\"Meu numero da sorte é: \",N); \n    +numeroDaSorte(N).\n\n\n\n//Dizer Nome\n+!dizerNome <- \n    .my_name(N); \n    .print(\"Meu nome é: \",N).\n\n//Saudação...\n+!fazerSaudacao <- \n    .time(H,M,S); \n    !saudar(H).\n\n+!saudar(H): H >= 6   & H <= 12 <- .print(\"Bom dia!\").\n+!saudar(H): H > 12   & H <= 17 <- .print(\"Boa tarde!\").\n+!saudar(H): (H >= 18  & H <= 23) | (H < 6 ) <- .print(\"Boa noite!\").\n\n\n\n+oi[source(Alguem)] <-\n .wait(5000);\n .sendOut(Alguem,tellHow,\"+!escolherNrdaSorte <- .random(R); N = ((R * 1000) div 1); .print(\\\"Meu numero da sorte é: \\\",N); +numeroDaSorte(N).\"); \n .wait(3000);\n .print(\"Oi \",Alguem,\" me diga seu nr da sorte!\");\n .sendOut(Alguem,achieve,dizerNome);\n .wait(3000);\n .sendOut(Alguem,achieve,escolherNrdaSorte);\n .wait(3000);\n .sendOut(Alguem,askOne,numeroDaSorte(NSorte),Resposta);\n +Resposta;\n .print(\"Legal saber que seu nr é \",Resposta);\n.\n\n\n\n\n\n\n\n\n\n"},{"archClass":"Communicator","name":"cliente","sourceCode":"!conectar.\n\n+!conectar <-\n\t.connectCN(skynet.chon.group,5000,\"0fc15248-816d-4942-813d-c24038387561\").\n\n//!ola.\n\n+!ola <-\n    .print(\"Mandando oi\");\n    !olaIoT.\n\n+!olaIoT <-\n .print(\"Oi via IoT\");\n .sendOut(\"9fdc0520-22ee-4701-a37b-852f25a3164c\",tell,oi).\n\n+!dizerNome <- \n    .my_name(N); \n    .print(\"Meu nome é: \",N)."}],"firmwares":[]}