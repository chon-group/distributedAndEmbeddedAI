{"id":34,"name":"chefAfood","agents":[{"archClass":"Communicator","name":"chef","sourceCode":"/* Initial beliefs and rules */\nmyIoTAddress(\"af467a22-eafc-4e87-9f57-882740ab0710\").\nmenu([\"Popcorn chicken\", \"Potato tortilla\", \"Butter chicken moussaka\"]).\nlastOrder(0).\n\n/* Initial goals */\n!connectIoT.\n\n/* Plans */\n+!connectIoT: myIoTAddress(UUID) <-\n\t.connectCN(\"skynet.chon.group\",5000,UUID);\n\t.print(\"Waiting for orders...\"); .random(R); .wait(30000*R);\n\t.disconnectCN; .wait(3000); !connectIoT.\n-!connectIoT <- .wait(20000); !connectIoT.\n\n+!order(Dish,Qtd)[source(Client)]: lastOrder(L) <-\n\tNr=(L+1); -+lastOrder(Nr);\n\t.print(\"Client: \",Client,\" Order:\",Nr,\" - Preparing \",Qtd,\" \",Dish);\n\t.sendOut(Client,tell,foodArrived(Nr,Dish,Qtd))."}],"firmwares":[]}