{"id":27,"name":"ethicalScooter","agents":[{"archClass":"Jason","name":"distribution","sourceCode":"{include(\"printer.asl\")}\n{include(\"calculator.asl\")}\n{include(\"batching.asl\")}\n{include(\"loader.asl\")}\n\nagents::maintenance_agent(maintenance).\nagents::zone_agent(zoneLambohov).\nagents::zone_agent(zoneCampusValla).\nagents::zone_agent(zoneInnerstaden).\n\nconfig::config_low_stock(5).\nconfig::allocationRate(20).\nconfig::zoneTransferRate(15).\nconfig::maintenanceThreshold(2).\n\n!initialAllocation.\n\n/* It receives a zone belief from a zone and translates it to a zone_status belief removing the previous one. */\n+zone(zone(Area),\n      type(Type),\n      demand(Demand),\n      available(A),\n      inactive(U),\n      event(Event))[source(Client)] <-\n\t.abolish(zone_status(zone(_),\n                 type(_),\n                 demand(_),\n                 available(_),\n                 inactive(_),\n                 event(_))[source(Client)]);\t\n\t.abolish(zone( _, _, _, _, _, _)[source(Client)]);\n\t\t+zone_status(zone(Area),\n\t     \t     type(Type),\n\t     \t     demand(Demand),\n\t     \t     available(A),\n\t     \t     inactive(U),\n\t     \t     event(Event))[source(Client)].\n\n+zone_status(\n    zone(Z),\n    type(T),\n    demand(D),\n    available(A),\n    inactive(I),\n    event(E))[source(Sender)] <-\n\t!printZoneStatus(Sender, Z, T, D, A, I, E);\n\t-last_available(Z, _);\n    \t+last_available(Z, A);\n\t-zone_status(\n        \tzone(Z),\n        \tzone_name(X),\n        \ttype(T),\n        \tdemand(D),\n        \tavailable(A),\n        \tinactive(I),\n        \tevent(E)[source(Sender)]);\n\t!decideDistribution(Z, T, D, A, I, E).\n\n+scooter(Id, X, Y) <-\n\t.print(\"I received the scooter \", Id, \" refurbished.\").\n\t\n+!decideDistribution(Zone, _, _, _, _, Event) :\n    config::allocationRate(Rate) & \n    Event \\== none <-\n    \t!calculateTransferQuantity(Zone, Qty);\n\t.print(\"[PEAK EVENT] Prioritize redistribution of \", Qty ,\" scooter(s) to zone \", Zone, \" to meet event \", Event, \".\");\n\t!allocateScooters(Zone, Qty, event).\n\n+!decideDistribution(Zone, _, _, _, Inactives, _):\n    config::maintenanceThreshold(Limit) &\n    Inactives >= Limit &\n    not movingInProgress(Zone) <-\n    \t.print(\"Asking \", Inactives, \" inactive scooters to move from \", Zone, \" to maintenance.\");\n    \t!askToMove(Zone).\n\n+!decideDistribution(Zone, _, high, Available, _, _):\n    config::config_low_stock(Stock) & \n    Available < Stock <-\n\t!calculateTransferQuantity(Zone, Qty);\n\t.print(\"[HIGH DEMAND]: Attending high demand and low availability in \", Zone, \". Trying to send \", Qty, \" scooters.\");\n \t!allocateScooters(Zone, Qty, demand).\n\n// PERCEBA QUE AQUI ELE ALOCA INDEPENDENTE DA QUANTIDADE E DA COMO ATENDIDO. SE HOUVER 1, ALOCA.\n@tiodu[atomic]\n+!allocateScooters(Zone, Qty, _): \t\n    .findall(scooter(Id, free, none), scooter(Id, free, none), FreeScooters) &\n    FreeScooters \\== [] <-\n\t!select(Qty, FreeScooters, SelectedScooters);\n\t!removeScooters(SelectedScooters);\n\t.send(Zone, tell, SelectedScooters);\n\t!increaseAvailability(Zone, Qty);\n\t.print(\"Sending \", Qty, \" scooters (\", SelectedScooters, \") to \", Zone, \".\").\n\n/* There is no free scooters in distribution at this time. */\n+!allocateScooters(Zone, Qty, Type):\n    .findall(scooter(Id, free, none), scooter(Id, free, none), FreeScooters) &\n    FreeScooters == [] <-\n\t.print(\"There is no available scooters in distribution right now. Let's search in another Zone.\");\n\t!!transferFromAnotherZone(Zone, Type);\n\t.fail.\n\n+!removeScooters([scooter(Id, _, _)|Rest]) <-\n\t-scooter(Id, _, _)[source(_)];\n\t!removeScooters(Rest).\n\n+!removeScooters([]). \t\n\n-!decideDistribution(Zone, _, _, _, _, Event).\n\n+!askToMove(Zone) <-\n    \t.send(Zone, achieve, removeInactives);\n\t+movingInProgress(Zone)[source(Zone)].\n\n// ==============================\n// ZONE TRANSFER\n// ==============================\n\n+!transferFromAnotherZone(TargetZone, Type):\n    agents::zone_agent(SourceZone) &\n    SourceZone \\== TargetZone &\n    last_available(SourceZone, Available) &\n    Available > 0 &\n    config::zoneTransferRate(Rate) &\n    not transferInProgress(SourceZone, TargetZone)[source(SourceZone)] <-\n\t+transferInProgress(SourceZone, TargetZone)[source(SourceZone)];\n    \t!calculatePercentage(Available, Rate, BaseQty);\n    \tQty = math.max(1, BaseQty);\n\t.print(\"[ZONE TRANSFER] Asking for \", SourceZone, \" for transferring \", Qty, \" scooter(s) to \", TargetZone, \".\");\n\t.send(SourceZone, achieve, transferScooters(TargetZone, Qty));\n\t!inform(TargetZone, Type).\n\t\n+!transferFromAnotherZone(TargetZone, _):\n    transferInProgress(SourceZone, TargetZone)[source(SourceZone)] <-\n\t.print(\"[ZONE TRANSFER] There is an active transferring occurring for \", TargetZone, \".\").\n\n+!inform(Zone, event) <-\n\t.send(Zone, tell, setEvent(event(none))).\n\n+!inform(Zone, demand).\n\n+transferred_scooters(TargetZone, Scooters)[source(SourceZone)] <-\n\t.print(\"Received scooters from \", SourceZone, \" to forward to \", TargetZone, \": \", Scooters, \".\");\n\t.send(TargetZone, tell, Scooters);\n\t-transferred_scooters(TargetZone, Scooters)[source(SourceZone)]."},{"archClass":"Jason","name":"zoneCampusValla","sourceCode":"{include(\"manager.asl\")}\n{include(\"reporting.asl\")}\n{include(\"tracer.asl\")}\n{include(\"fleet.asl\")}\n{include(\"marketing.asl\")}\n\n/* Demand and Satisfaction could be low, medium, or high. \n * Satisfaction could also be evaluation.\n * Hard-coded beliefs. */\ntype(\"University\").\ndemand(low).\nevent(none).\n\n/* Historical allocations. */\nallocations::totalAllocations(25, 1, 2026).\nallocations::totalAllocations(20, 2, 2026).\nallocations::totalAllocations(35, 3, 2026).\nallocations::totalAllocations(40, 4, 2026).\n\n/* Historical restrictions. */\nrestrictions::totalRestrictions(10, 1, 2026).\nrestrictions::totalRestrictions(15, 2, 2026).\nrestrictions::totalRestrictions(11, 3, 2026).\nrestrictions::totalRestrictions(18, 4, 2026).\n\n!reportStatus.\n\n+ticket(Id) <-\n\t.print(\"I received the ticket \", Id, \".\");\n\t.send(auditor, achieve, accountability(Id));\n\t.send(auditor, achieve, responsibility(Id))."},{"archClass":"Jason","name":"zoneLambohov","sourceCode":"{include(\"manager.asl\")}\n{include(\"reporting.asl\")}\n{include(\"tracer.asl\")}\n{include(\"fleet.asl\")}\n{include(\"marketing.asl\")}\n\n/* Demand and Satisfaction could be low, medium, or high. \n * Satisfaction could also be evaluation.\n * Hard-coded beliefs. */\ndemand(low).\ntype(\"Neighborhood\").\nevent(none).\n\n/* Historical allocations. */\nallocations::totalAllocations(11, 1, 2026).\nallocations::totalAllocations(12, 2, 2026).\nallocations::totalAllocations(14, 3, 2026).\nallocations::totalAllocations(16, 4, 2026).\n\n/* Historical restrictions. */\nrestrictions::totalRestrictions(10, 1, 2026).\nrestrictions::totalRestrictions(10, 2, 2026).\nrestrictions::totalRestrictions(11, 3, 2026).\nrestrictions::totalRestrictions(15, 4, 2026).\n\n!reportStatus.\n\n+ticket(Id) <-\n\t.print(\"I received the ticket \", Id, \".\");\n\t.send(auditor, achieve, accountability(Id));\n\t.send(auditor, achieve, responsibility(Id))."},{"archClass":"Jason","name":"maintenance","sourceCode":"maintenance_capacity(2).\nready_transfer_threshold(4).\n\n+scooter(Id, _, _) <- \n\t!processRepair.\n\n+!processRepair: \n    not repairing <-\n\t+repairing;\n\t!checkRepairs.\n\n+!processRepair: \n    repairing <- \n\t.print(\"Our Staff is totally busy right now!\").\n\n+!checkRepairs: \t\n    .findall(scooter(Id, inactive, none), scooter(Id, inactive, none), InactiveScooters) &\n    .length(InactiveScooters, Qty) <-\n\t!selectScooters(InactiveScooters, Qty).\n\n+!checkRepairs <-\n    \t.print(\"There is scooters to repair.\").\n\n+!selectScooters(InactiveScooters, Qty): \n    Qty >= 2 <-\t\n\t+repairing;\n\t.print(\"I've got 2 or more to fix: \", InactiveScooters);\n\t!selectScootersToRepair(InactiveScooters, []).\n\n+!selectScooters(InactiveScooters, Qty): \n    Qty == 1 <-\t\n\t.print(\"I've got 1 to fix: \", InactiveScooters);\n\t!repairScooters(InactiveScooters).\n\n+!selectScooters(InactiveScooters, Qty): \n    Qty == 0 <-\t\n\t-repairing;\n\t.print(\"I don't have scooters to fix.\").\n\t\n+!selectScootersToRepair([], List) <-\n    \t.print(\"Selected scooters: \", List);\n\t!repairScooters(List).\n\n+!selectScootersToRepair([scooter(Id, Status, Ref)|Rest], List):\n    .length(List, Qtt) &\n    Qtt < 2 <-\n    \t.print(\"Selecting scooter \", Id, \" to repair.\");\n    \tNewList = [scooter(Id, Status, Ref)|List];\n    \t!selectScootersToRepair(Rest, NewList).\n\n+!selectScootersToRepair(_, List):\n    .length(List, Qtt) &\n    Qtt >= 2 <-\n    \t.print(\"Repair limit reached: \", List);\n\t!repairScooters(List).\n\n+!repairScooters([scooter(Id, Status, Ref)|Rest]) <-\t\t \n\t.wait(1000);\n\t.print(\"Repairing \", scooter(Id, Status, Ref));\n\t-scooter(Id, _, _)[source(Zone)];\n\t+scooter(Id, free, none)[source(Zone)];\n\t!repairScooters(Rest).\n\n+!repairScooters([]) <- \n    \t-repairing;\n    \t.print(\"Repair process finished.\");\n    \t!sendScootersToDistribution;\n\t!processRepair.\n\t\n+!repairScooters([scooter(Id, Status, Ref)]) <- \n    \t-repairing;\n    \t.print(\"Repair process finished.\");\n    \t!sendScootersToDistribution;\n\t!processRepair.\n\n+!sendScootersToDistribution: \n    .findall(scooter(Id, free, none), scooter(Id, free, none), ReadyScooters) &\n    .length(ReadyScooters, Qtt) &\n    ready_transfer_threshold(Threshold) &\n    Qtt >= Threshold <- \n\t.print(\"Sending the following scooters to the Distribution: \", ReadyScooters);\n\t.send(distribution, tell, ReadyScooters);\n\t!removeSentScooters(ReadyScooters).\n\n+!sendScootersToDistribution <-\n\t.print(\"Waiting for more ready scooters until reach the minimun threshold.\").\n\n+!removeSentScooters([scooter(Id, _, _)|Rest]) <-\n\t-scooter(Id, _, _)[source(_)];\n\t!removeSentScooters(Rest).\n\n+!removeSentScooters([])."},{"archClass":"Jason","name":"auditor","sourceCode":"/* It receives a requisition for explaining a ticket. It answers with the reason and the responsible for the decision. */\n+!requisition(Id)[source(Client)]:\n\toperation(Id, Client, Responsible, Message, Type) <-\n\t\t.print(\n    \t\t\t\"[\", Id, \"]: Requisition number \", Id, \" received.\",\n    \t\t\t\"\\n[\", Id, \"]: \", Message,\n    \t\t\t\"\\n[\", Id, \"][Responsible]: \", Responsible,\n        \t\t\"\\n\"\n\t\t);\n\t\t.send(Client, tell, request(Id, Responsible, Message, Type)).\n\n/* It receives a requisition for explaining a ticket. */\n+!explainability(Id)[source(Client)]:\n\toperation(Id, Client, Responsible, Message, explainability) <-\n\t\t.print(\n    \t\t\t\"[\", Id, \"]: Requisition number \", Id, \" received.\",\n    \t\t\t\"\\n[\", Id, \"]: \", Message,\n        \t\t\"\\n\"\n\t\t);\n\t\t.send(Client, tell, request(Id, Responsible, Message, Type)).\n\n/* It receives a requisition for accounting a ticket. */\n+!accountability(Id)[source(Client)]:\n\toperation(Id, Client, Responsible, Message, accountability) <-\n\t\t.print(\n    \t\t\t\"[\", Id, \"]: Requisition number \", Id, \" received.\",\n    \t\t\t\"\\n[\", Id, \"]: \", Message,\n        \t\t\"\\n\"\n\t\t);\n\t\t.send(Client, tell, request(Id, Responsible, Message, Type)).\n\n/* It receives a requisition for finding the responsible for the decision of a ticket. */\n+!responsibility(Id)[source(Client)]:\n\toperation(Id, Client, Responsible, Message, _) <-\n\t\t.print(\n    \t\t\t\"[\", Id, \"]: Requisition number \", Id, \" received.\",\n    \t\t\t\"\\n[\", Id, \"][Responsible]: \", Responsible,\n        \t\t\"\\n\"\n\t\t);\n\t\t.send(Client, tell, request(Id, Responsible, Message, Type)).\n\n/* The client does not have access to the ticket. */\n-!requisition(Id)[source(Client)] <- \n\t\t.print(\"The client \", Client, \" does not have access to id \", Id ,\".\").\n\n/* The ticket does not exist for this motive. */\n-!explainability(Id)[source(Client)] <-\n\t\t.print(\"There is no explainability related to id \", Id ,\".\").\n\n/* The ticket does not exist for this motive. */\n-!accountability(Id)[source(Client)] <-\n\t\t.print(\"There is no accountability related to id \", Id ,\".\").\n\n/* The client does not have access to the ticket. */\n-!responsibility(Id)[source(Client)] <-\n\t\t.print(\"The client \", Client, \" does not have access to id \", Id ,\".\")."},{"archClass":"Jason","name":"teddy","sourceCode":"//!start.\n\n+!start <-\n\t.send(booking, achieve, reservation(6));\n\t.wait(3000);\n\t.send(booking, achieve, start(1));\n\t.wait(3000);\n\t.send(booking, achieve, return(8));\n\t.wait(3000);\n\t.send(booking, achieve, return(9));\n\t.wait(3000);\n\t.send(booking, achieve, start(10)).\n\n+!explainToMe <-\n\t.send(auditor, achieve, requisition(1));\n\t.send(auditor, achieve, responsibility(3)).\n\n+ticket(Id) <-\n\t.print(\"I received the ticket \", Id, \".\");\n\t.send(auditor, achieve, accountability(Id));\n\t.send(auditor, achieve, responsibility(Id)).\n"},{"archClass":"Jason","name":"kate","sourceCode":"//!start.\n\n+!start <-\n\t.send(booking, achieve, reservation(2));\n\t.wait(2000);\n\t.send(booking, achieve, return(8));\n\t.wait(2000);\t\n\t.send(booking, achieve, start(9));\n\t.wait(2000);\n\t.send(booking, achieve, informUnavailability(zoneLambohov)).\n\n\n+ticket(Id) <-\n\t.print(\"I received the ticket \", Id, \".\");\n\t.send(auditor, achieve, accountability(Id));\n\t.send(auditor, achieve, responsibility(Id))."},{"archClass":"Jason","name":"booking","sourceCode":"{include(\"tracer.asl\")}\n\n/* All scooters from campusValla zone. */\nscooter(1, zoneCampusValla)[source(zoneCampusValla)].\nscooter(2, zoneCampusValla)[source(zoneCampusValla)].\nscooter(3, zoneCampusValla)[source(zoneCampusValla)].\nscooter(4, zoneCampusValla)[source(zoneCampusValla)].\nscooter(5, zoneCampusValla)[source(zoneCampusValla)].\nscooter(6, zoneCampusValla)[source(zoneCampusValla)].\nscooter(7, zoneCampusValla)[source(zoneCampusValla)].\nscooter(8, zoneCampusValla)[source(zoneCampusValla)].\nscooter(9, zoneCampusValla)[source(zoneCampusValla)].\nscooter(10, zoneCampusValla)[source(zoneCampusValla)].\n\n/* All scooters from lambohov zone. */\nscooter(11, zoneLambohov)[source(zoneLambohov)].\nscooter(12, zoneLambohov)[source(zoneLambohov)].\nscooter(13, zoneLambohov)[source(zoneLambohov)].\nscooter(14, zoneLambohov)[source(zoneLambohov)].\nscooter(15, zoneLambohov)[source(zoneLambohov)].\nscooter(16, zoneLambohov)[source(zoneLambohov)].\nscooter(17, zoneLambohov)[source(zoneLambohov)].\nscooter(18, zoneLambohov)[source(zoneLambohov)].\nscooter(19, zoneLambohov)[source(zoneLambohov)].\nscooter(20, zoneLambohov)[source(zoneLambohov)].\n\n/* All scooters from Innerstaden zone. */\nscooter(21, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(22, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(23, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(24, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(25, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(26, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(27, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(28, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(29, zoneInnerstaden)[source(zoneInnerstaden)].\nscooter(30, zoneInnerstaden)[source(zoneInnerstaden)].\n\n/* It receives a start request from an user and redirects it to a specific Zone. */\n+!start(Id)[source(Client)]:\n    scooter(Id, Zone) &\n    Zone \\== maintenance <-\n\t\t.send(Zone, achieve, start(Id, Client)).\t\n\n/* It is not possible to start a scooter if it is maintenance. */\n+!start(Id)[source(Client)]:\n    scooter(Id, Zone) &\n    Zone == maintenance <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to use is under maintenance.\").\n\n\n/* It receives a return request from an user and redirects it to a specific Zone. */\n+!return(Id)[source(Client)]:\n\tscooter(Id, Zone) &\n\tZone \\== maintenance <-\n\t\t.send(Zone, achieve, return(Id, Client)).\n\n/* It is not possible to return a scooter if it is maintenance. */\n+!return(Id)[source(Client)]:\n    scooter(Id, Zone) &\n    Zone == maintenance <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is under maintenance.\").\n\n/* It receives a book request from an user and redirects it to a specific Zone. */\n+!reservation(Id)[source(Client)]:\n\tscooter(Id, Zone) &\n\tZone \\== maintenance <-\n\t\t.send(Zone, achieve, reservation(Id, Client)).\t\t\n\n/* It receives a unavailability from a user and redirects it to a specific Zone. */\n+!informUnavailability(Zone) <-\n\t.send(Zone, tell, restrained).\n\n/* It receives a belief from a zone specifying that a scooter is under maintenance. */\n+fromMaintenance(Id) <-\n\t.abolish(fromMaintenance(Id));\n\t-scooter(Id, _)[source(_)];\t\n\t+scooter(Id, maintenance)[source(maintenance)].\n\n+fromZone(scooter(Id, Client)) <-\n\t.abolish(fromZone(_));\n\t-scooter(Id, _)[source(_)];\n\t+scooter(Id, Client)[source(Client)].\n\n+fromZone(Client, [scooter(Id, _, _)|Rest]) <-\n\t.abolish(fromZone(Client,_));\n\t+fromZone(scooter(Id, Client));\n\t+fromZone(Client, Rest).\n\n+fromZone(Client, []) <-\n\t.abolish(fromZone(Client,[]))."},{"archClass":"Jason","name":"manager","sourceCode":"/* Plans for making a scooter reservation. */\n/* It makes a reservation. */\n+!reservation(Id, Client):\n    scooter(Id, free, _) <-\n\t-scooter(Id, _, _);\n\t+scooter(Id, reserved, Client);\n\t.print(\"Reservation made for scooter \", Id, \" and user \", Client, \".\");\n\t!reportStatus.\n\n/* It is not possible to book if the scooter is busy. */\n+!reservation(Id, Client):\n    scooter(Id, busy, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to make a reservation is busy.\").\n\n/* It is not possible to book if the scooter is already reserved. */\n+!reservation(Id, Client):\n    scooter(Id, reserved, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to make a reservation is already reserved.\").\n\n/* It is not possible to book if the scooter is inactive. */\n+!reservation(Id, Client):\n    scooter(Id, inactive, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to make a reservation is out of service and waiting for maintenance.\").\n\n/* It is not possible to book if the scooter is not in this zone. */\n+!reservation(Id, Client):\n    not scooter(Id, _, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to make a reservation is not at Campus Valla anymore.\").\t\n\n/* Plans for starting the use of a scooter. */\n/* It starts the use of a scooter. */\n+!start(Id, Client):\n    (scooter(Id, reserved, Client) |\n    scooter(Id, free, _)) &\n    not scooter(_, busy, Client) <-\n\t-scooter(Id, _, _);\n\t+scooter(Id, busy, Client);\n\t.print(\"User \", Client, \" started using scooter \", Id, \".\");\n\t!!reportStatus;\n\t!incrementDemand;\n\t!sumAllocations(Total);\n\t.send(distribution, tell, newAccumulatedAllocations(Total)).\n\n/* It is not possible to use a new scooter while you are using another. */\n+!start(Id, Client):\n    scooter(_, busy, Client) <-\n\t!auditAndReply(Id, Client, \"You already have a scooter in use.\").\n\n/* It is not possible to use a scooter if it is busy. */\n+!start(Id, Client):\n    scooter(Id, busy, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to use is busy.\").\n\n/* It is not possible to use a scooter if it is reserved to other user. */\n+!start(Id, Client):\n    scooter(Id, reserved, Holder) &\n    Client \\== Holder <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to use is reserved for another user.\").\n\n/* It is not possible to use an inactive scooter. */\n+!start(Id, Client):\n    scooter(Id, inactive, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to use is out of service and waiting for maintenance.\").\n\n/* It is not possible to use a scooter if it is not in this zone. */\n+!start(Id, Client):\n    not scooter(Id, _, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to use is not at this zone anymore.\").\t\n\n/* Plans for returning a scooter. */\t\t\n/* It returns a scooter. */\n+!return(Id, Client):\n    scooter(Id, busy, Client) <-\n\t-scooter(Id, _, _);\n\t+scooter(Id, free, none);\n\t.print(\"Scooter \", Id, \" returned by \", Client, \".\");\n\t!reportStatus.\n\n/* It is not possible to return a scooter if it is in use by another user. */\n+!return(Id, Client):\n    scooter(Id, busy, Holder) &\n    Client \\== Holder <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is in use by another user.\").\n\n/* It is not possible to return a scooter if it is free. */\n+!return(Id, Client):\n    scooter(Id, free, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is not in use.\").\n\n/* It is not possible to return a scooter if it is reserved to someone. */\n+!return(Id, Client):\n    scooter(Id, reserved, Holder) &\n    Client \\== Holder <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is not in use and reserved to another user.\").\n\n/* It is not possible to return a scooter if it is not in use even if reserved by the same user. */\n+!return(Id, Client):\n    scooter(Id, reserved, Client) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is not in use although reserved by you.\"). \n\n/* It is not possible to retunr a scooter if it is inactive. */\n+!return(Id, Client):\n    scooter(Id, inactive, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is out of service and waiting for maintenance.\").\n\n/* It is not possible to return a scooter that is not in this zone. */\n+!return(Id, Client):\n    not scooter(Id, _, _) <-\n\t!auditAndReply(Id, Client, \"The scooter you've tried to return is not in this zone anymore.\")."},{"archClass":"Jason","name":"reporting","sourceCode":"/* It counts all free scooters from a zone. */\n+!countAvailableScooters(Qtt) <-\n\t.findall(Id, scooter(Id, free, _), FreeScootersList);\n    \t.length(FreeScootersList, Qtt).\n\n/* It counts all busy scooters from a zone. */\n+!countUnavailableScooters(Qtt) <-\n    \t.findall(Id, scooter(Id, busy, _), BusyScootersList);\n    \t.length(BusyScootersList, Qtt).\n\n/* It counts all reserved scooters from a zone. */\n+!countReservedScooters(Qtt) <-\n    \t.findall(Id, scooter(Id, reserved, _), ReservedScootersList);\n    \t.length(ReservedScootersList, Qtt).\n\n/* It counts all inactive scooters from a zone. */\n+!countInactiveScooters(Qtt) <-\n    \t.findall(Id, scooter(Id, inactive, _), InactiveScootersList);\n    \t.length(InactiveScootersList, Qtt).\n\n/* It sums the total of allocations of all time. In this version, there is only 2026 allocations. */\n+!sumAllocations(Total) <-\n\t.findall(Value, allocations::totalAllocations(Value, _, _), List);\n\tTotal = math.sum(List).\n\n/* It sums the total of restrictions of all time. In this version, there is only 2026 restrictions. */\n+!sumRestrictions(Total) <-\n\t.findall(Value, restrictions::totalRestrictions(Value, _, _), List);\n\tTotal = math.sum(List).\n\n/* It increments the allocation demand for the current month. */\n+!incrementDemand: \n    .date(Year, Month, _) &\n    allocations::totalAllocations(Qtt, Month, Year) <-\n\t-allocations::totalAllocations(Qtt, Month, Year);\n\t+allocations::totalAllocations(Qtt + 1, Month, Year);\n\t.print(\"Updating the monthly demand.\").\n\n/* It creates the first allocation for the current month. */    \n+!incrementDemand: \n    .date(Year, Month, _) <-\n\t+allocations::totalAllocations(1, Month, Year);\n\t.print(\"Creating the first demand this month.\").\n\n/* It increments the restrictions for the current month. */\n+!incrementRestriction: \n    .date(Year, Month, _) &\n    restrictions::totalRestrictions(Qtt, Month, Year) <-\n\t-restrictions::totalRestrictions(Qtt, Month, Year);\n\t+restrictions::totalRestrictions(Qtt + 1, Month, Year);\n\t.print(\"Updating the monthly restrictions.\").\n\n/* It creates the first restriction for the current month. */     \n+!incrementRestriction: \n    .date(Year, Month, _) <-\n\t+restrictions::totalRestrictions(1, Month, Year);\n\t.print(\"Creating the first restriction this month.\").\n\n/* It reports to the distribution some information. */ \n+!reportStatus:\n    type(T) &\n    event(E) &\n    demand(D) <-\n    \t.my_name(Me);\t\n\t!countAvailableScooters(A);\n\t!countInactiveScooters(I);\n\t.print(\"Reporting! Available: \", A, \" - Inactives: \", I, \".\");\n\t.send(distribution, tell, zone(zone(Me),\n            \t\t\t       type(T),\n            \t\t\t       demand(D),\n            \t\t\t       available(A),\n            \t\t\t       inactive(I),\n            \t\t\t       event(E))\t\t\t       \t\t\t\n\t);\n\t!sumAllocations(Allocations);\n\t.send(distribution, tell, newAccumulatedAllocations(Allocations));\n\t!sumRestrictions(Repressed);\n\t.send(distribution, tell, newAccumulatedRepressed(Repressed)).\n\n/* It receives from booking and increment restrictions. */\n+restrained <-\n\t.abolish(restrained);\n \t!incrementRestriction;\n\t!sumRestrictions(Total);\n\t.send(distribution, tell, newAccumulatedRepressed(Total)).\t"},{"archClass":"Jason","name":"tracer","sourceCode":"/* It sends a register to the auditor concerning the explainability and responsibility of an act. */\n+!auditAndReply(Id, Client, Message) <-\n\t.time(H, Min, S);\n\t.date(Y, M, D);\n\t.concat(Id, Y, M, D, S, Min, H, \"-\", Client, Ticket); \n\t.my_name(Responsible);\n\t.send(auditor, tell, operation(Ticket,\n\t\t\t\t    Client, \n\t\t\t\t    Responsible, \n\t\t\t\t    Message, \n\t\t\t\t    accountability));\n\t.send(Client, tell, ticket(Ticket))."},{"archClass":"Jason","name":"fleet","sourceCode":"/* It starts the process of removing inactives scooters to maintenance. */ \n+!removeInactives <-\n    .findall(Id, scooter(Id, inactive, _), InactiveScooters);\n    .print(\"Inactive scooters found: \", InactiveScooters);\n    !moveInactives(InactiveScooters).\n\n/* It iterates the inactive list to move scooter by scooter to maintenance. */\n+!moveInactives([Id|Rest]) <-\n    !moveToMaintenance(Id);\n    !moveInactives(Rest).\n\n/* The inactive list has reached to its end. */\n+!moveInactives([]) <-\n\t.my_name(Me);\n\t.send(distribution, untell, movingInProgress(Me)).\n\n/* It moves a scooter to maintenance. */\n+!moveToMaintenance(Id):\n    scooter(Id, _, _) <-\n\t-scooter(Id, _, _)[source(_)];\n\t.send(maintenance, tell, scooter(Id, inactive, none));\n\t.print(\"Sent scooter \", Id, \" to maintenance agent.\");\n\t.send(booking, tell, fromMaintenance(Id)).\n\n/* If the scooter is not in this zone, it informs the auditor. */\n+!moveToMaintenance(Id):\n    not scooter(Id, _, _) <-\n\t.my_name(Client);\n\t!auditAndReply(Id, Client, \"The scooter you've tried to move is not at this zone anymore.\").\t\t\n\n/* It starts the process to transfers scooters to another zone. The distribution agent activates this plan by sending an achieve message. */\n+!transferScooters(TargetZone, Qty)[source(distribution)] <-\n    \t.findall(scooter(Id, free, none),\n                 scooter(Id, free, none),\n                 FreeScooters);\n    \t.length(FreeScooters, Available);\n\t!checkAvailability(TargetZone, Qty, Available, FreeScooters);\n\t.my_name(Me);\n\t.send(distribution, untell, transferInProgress(Me, TargetZone)).\n\n+!checkAvailability(TargetZone, Qty, Available, FreeScooters):\n    Available >= Qty <-\n\t!selectScooters(Qty, FreeScooters, SelectedScooters);\n\t!removeScooters(SelectedScooters);\n\t.send(distribution, tell, transferred_scooters(TargetZone, SelectedScooters));\n\t.send(booking, tell, fromZone(TargetZone, SelectedScooters)).\n\n+!checkAvailability(TargetZone, Qty, Available, FreeScooters):\n    Available < Qty <-\n\t.print(\"There isn't enough scooters to transfer.\").\n\n/* It selects scooters recursively. */ \n+!selectScooters(Qty, [Scooter|Rest], [Scooter|Selected]) :\n     Qty > 0 <-\n    \tNewQty = Qty - 1;\n    \t!selectScooters(NewQty, Rest, Selected).\n\n/* The base case when the quatity selected hits zero. */\n+!selectScooters(0, _, []).\n\n/* Removes the scooters from this zone. */\n+!removeScooters([scooter(Id, _, _)[source(_)]|Rest]) <-\n\t-scooter(Id, _, _)[source(_)];\n    \t!removeScooters(Rest).\n\n/* All selected scooters have been transferred. */\n+!removeScooters([]) <-\n    \t.print(\"All selected scooters have been transferred.\").\n\n+scooter(Id, free, none)[source(distribution)] <-\n\t.my_name(Me);\n\t.print(\"I received the scooter \", Id, \" from distribution.\");\n\t.send(booking, tell, fromZone(scooter(Id, Me)))."},{"archClass":"Jason","name":"marketing","sourceCode":"/* It sets a new event informed by the City Hall for this zone. */ \n+setEvent(NewEvent)[source(cityHall)]:\n    event(CurrentEvent) <-\n\t.abolish(setEvent(NewEvent));\n\t-event(CurrentEvent);\n    \t+event(NewEvent);\n\t.print(\"New event \", NewEvent, \" detected. Changing from \", CurrentEvent, \" to \", NewEvent, \".\");\n\t!reportStatus.\n\n/* It sets an event as attended by the Distribution by inserting none in the Belief. */ \n+setEvent(event(NewEvent))[source(distribution)]:\n    event(CurrentEvent) <-\n\t.abolish(setEvent(event(NewEvent)));\n\t-event(CurrentEvent);\n    \t+event(NewEvent);\n\t.print(\"The event \", CurrentEvent, \" was attended by the Distribution.\").\n\n+setDemand(NewDemand) <-\n\t.abolish(setDemand(NewDemand));\n\t-demand(_);\n\t+demand(NewDemand);\n\t!reportStatus."},{"archClass":"Jason","name":"cityHall","sourceCode":"/* It considers an Id, the zone agent, and the event using a Term.*/\nevent(1, zoneCampusValla, campus_party).\nevent(2, zoneLambohov, evening_show).\nevent(3, zoneLambohov, evening_show).\n\neventInterval(10000).\ncurrentEvent(1).\n\n!start.\n\n+!start <-\n    \t.print(\"Starting communicating events to the zones.\");\n    \t.wait(10000);\n\t.send(zoneLambohov, tell, setDemand(high));\n    \t.wait(5000);\n\t!nextEvent.\n\n/* It starts by getting the first event and informing the respective zone. */\n+!nextEvent:\n    currentEvent(Index) &\n    event(Index, Zone, Event) <-\n    \t!informEvent(Index, Zone, Event);\n    \t?eventInterval(Time);\n    \t.wait(Time);\n    \t!nextEvent.\n\n/* If there is no next event, the agent stops. */\n+!nextEvent:\n    currentEvent(Index) &\n    not event(Index, _, _) <-\n    \t.print(\"All programmed events were communicated to their respective zones.\").\n\n+!informEvent(Index, Zone, Event) <-\n\t.print(\"Sending event \", Event, \" to \", Zone, \".\");\n    \t.send(Zone, tell, setEvent(Event));\n    \t-currentEvent(Index);\n    \tNextIndex = Index + 1;\n    \t+currentEvent(NextIndex)."},{"archClass":"Jason","name":"zoneInnerstaden","sourceCode":"{include(\"manager.asl\")}\n{include(\"reporting.asl\")}\n{include(\"tracer.asl\")}\n{include(\"fleet.asl\")}\n{include(\"marketing.asl\")}\n\n/* Demand and Satisfaction could be low, medium, or high. \n * Satisfaction could also be evaluation.\n * Hard-coded beliefs. */\ntype(\"Neighborhood\").\ndemand(low).\nevent(none).\n\n/* Historical allocations. */\nallocations::totalAllocations(15, 1, 2026).\nallocations::totalAllocations(10, 2, 2026).\nallocations::totalAllocations(18, 3, 2026).\nallocations::totalAllocations(22, 4, 2026).\n\n/* Historical restrictions. */\nrestrictions::totalRestrictions(11, 1, 2026).\nrestrictions::totalRestrictions(10, 2, 2026).\nrestrictions::totalRestrictions(12, 3, 2026).\nrestrictions::totalRestrictions(14, 4, 2026).\n\n!reportStatus.\n\n+ticket(Id) <-\n\t.print(\"I received the ticket \", Id, \".\");\n\t.send(auditor, achieve, accountability(Id));\n\t.send(auditor, achieve, responsibility(Id))."},{"archClass":"Jason","name":"printer","sourceCode":"+!printZoneStatus(Sender, Z, T, D, A, I, E) <-\n    \t.print(\n        \t\"Received from: \", Sender,\n        \t\"\\n  - Zone: \", Z,\n        \t\"\\n  - Type: \", T,\n        \t\"\\n  - Demand: \", D,\n        \t\"\\n  - Available: \", A,\n        \t\"\\n  - Inactive: \", I,\n        \t\"\\n  - Event: \", E,\n        \t\"\\n\"\n    \t).\n\n+!printZoneTransfer(SourceZone, TargetZone, Qty) <-\n    \t.print(\"[ZONE TRANSFER] Transferindo \", Qty, \" patinetes de \", SourceZone, \" para \", TargetZone, \".\").\n"},{"archClass":"Jason","name":"calculator","sourceCode":"/* It receives the accumulated allocations from a zone and translates it to a accumulatedAllocations belief removing the previous one. */\n+newAccumulatedAllocations(Value)[source(Zone)] <-\n\t.abolish(newAccumulatedAllocations(_)[source(Zone)]);\t \t\n    \t-indicators::accumulatedAllocations(Zone,_)[source(Zone)];\n\t+indicators::accumulatedAllocations(Zone, Value)[source(Zone)].\n\n/* It receives the accumulated repressed demand from a zone and translates it to a repressedAllocations belief removing the previous one. */\n+newAccumulatedRepressed(Value)[source(Zone)] <-\n\t.abolish(newAccumulatedRepressed(_)[source(Zone)]);\t \t\n    \t-indicators::accumulatedRepressed(Zone,_)[source(Zone)];\n\t+indicators::accumulatedRepressed(Zone, Value)[source(Zone)].\n\n/* It calculates the scooters to be transferred based on the average allocations. */\n+!calculateTransferQuantity(Zone, Qtt):\n    indicators::accumulatedAllocations(Zone, Allocations) &\n    config::allocationRate(Rate) <-\n\t.date(_, Month, _);\n    \tAverage = Allocations / Month;\n    \t!calculatePercentage(Average, Rate, Qtt).\n\n/* If there is no historical allocations in this zone, it defines 1 scooter to be tranferred. */ \n+!calculateTransferQuantity(Zone, Qtt):\n    not indicators::accumulatedAllocations(Zone,_) <-\n    \tQtt = 1.\n\n+!calculatePercentage(Value, Rate, Result) <-\n    \tResult = math.ceil((Value * Rate) / 100).\n\n+!increaseAvailability(Zone, Qty):\n    last_available(Zone, Available) <-\n    \t-last_available(Zone, Available);\n    \tNewAvailable = Available + Qty;\n    \t+last_available(Zone, NewAvailable).\n\n+!increaseAvailability(Zone, Qty):\n    not last_available(Zone, _) <-\n    \t+last_available(Zone, Qty).\n\n+!decreaseAvailability(Zone, Qty):\n    last_available(Zone, Available) <-\n    \t-last_available(Zone, Available);\n    \tNewAvailable = Available - Qty;\n    \t+last_available(Zone, NewAvailable).\n\n+!decreaseAvailability(Zone, Qty):\n    not last_available(Zone, _) <-\n    \t.print(\"Não há registro local de disponibilidade para \", Z).\n"},{"archClass":"Jason","name":"batching","sourceCode":"/* It recursively selects the first Qtt items from a list and returns the selected items in the Selecteds list. */ \n+!select(Qtt, [Next|Rest], [Next|Selecteds]):\n    Qtt > 0 <-\n    \tNewQtt = Qtt - 1;\n    \t!select(NewQtt, Rest, Selecteds).\n\n+!select(0, _, []).\n\n+!select(_, [], []).\n"},{"archClass":"Jason","name":"loader","sourceCode":"/* It will distribute the scooters to their respective zones. */\n/* Scooter has Id, Status (free, reserved, busy, maintenance, or inactive), and client. */\n+!initialAllocation <-\n\t!caseTest1.\n\n/* CASE TEST 1: for inactives, events and high demand. */\n+!caseTest1 <- \n\t.send(zoneCampusValla, \n\t      tell,\n\t      [\n\t\tscooter(1, free, none),\n\t\tscooter(2, reserved, bob),\n\t\tscooter(3, inactive, none),\n\t\tscooter(4, inactive, none),\n\t\tscooter(5, inactive, none),\n\t\tscooter(6, inactive, none),\n\t\tscooter(7, inactive, none),\n\t\tscooter(8, inactive, none),\n\t\tscooter(9, inactive, none),\n\t\tscooter(10, inactive, none)\n\t      ]\n\t);\n\t.send(zoneLambohov, \n\t      tell,\n\t      [\n\t\tscooter(11, free, none),\n\t\tscooter(12, reserved, bob),\n\t\tscooter(13, inactive, none),\n\t\tscooter(14, inactive, none),\n\t\tscooter(15, inactive, none),\n\t\tscooter(16, inactive, none),\n\t\tscooter(17, inactive, none),\n\t\tscooter(18, inactive, none),\n\t\tscooter(19, inactive, none),\n\t\tscooter(20, inactive, none)\n\t      ]\n\t).\n\n/* CASE TEST 2: for low stock of scooters in distribution. */\n+!caseTest2 <- \n\t.send(zoneCampusValla, \n\t      tell,\n\t      [\n\t\tscooter(1, free, none),\n\t\tscooter(2, reserved, teddy),\n\t\tscooter(3, free, none),\n\t\tscooter(4, free, none),\n\t\tscooter(5, free, none),\n\t\tscooter(6, free, none),\n\t\tscooter(7, free, none),\n\t\tscooter(8, free, none),\n\t\tscooter(9, free, none),\n\t\tscooter(10, free, none)\n\t      ]\n\t);\n\t.send(zoneLambohov, \n\t      tell,\n\t      [\n\t\tscooter(11, free, none),\n\t\tscooter(12, reserved, carmen),\n\t\tscooter(13, free, none),\n\t\tscooter(14, free, none),\n\t\tscooter(15, free, none),\n\t\tscooter(16, free, none),\n\t\tscooter(17, free, none),\n\t\tscooter(18, free, none),\n\t\tscooter(19, free, none),\n\t\tscooter(20, free, none)\n\t      ]\n\t);\n\t.send(zoneInnerstaden, \n\t      tell,\n\t      [\n\t\tscooter(21, free, none),\n\t\tscooter(22, reserved, kate),\n\t\tscooter(23, free, none),\n\t\tscooter(24, free, none),\n\t\tscooter(25, free, none),\n\t\tscooter(26, free, none),\n\t\tscooter(27, free, none),\n\t\tscooter(28, free, none),\n\t\tscooter(29, free, none),\n\t\tscooter(30, free, none)\n\t      ]\n\t)."}],"firmwares":[]}